{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aronwagner-www-redirect",
  "main": "workers/www-redirect.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "www.aronwagner.com/*", "zone_name": "aronwagner.com" }],
}
