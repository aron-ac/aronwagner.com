{
  "name": "aronwagner-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/serve.js",
    "build:site": "node tools/build-site.js",
    "render:branding": "node tools/render-favicon.js && node tools/render-social.js",
    "deploy": "npm run build:site && deploy/deploy.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tools/test-browser.js",
    "check": "npm run format:check && npm run lint && npm test",
    "setup:browser": "puppeteer browsers install chrome",
    "render:previews": "node tools/render-surf-preview.cjs && node tools/render-bay-preview.cjs && node tools/render-maggie-preview.cjs && node tools/render-aisle-dash-preview.cjs",
    "test:browser:production": "npm run build:site && node tools/test-browser.js --root dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "puppeteer": "25.12.0"
  }
}
