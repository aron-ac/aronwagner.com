# aronwagner.com origin, behind Cloudflare. Installed to /etc/caddy/Caddyfile by
# deploy/provision.sh. The defaults are production; CI overrides the {$...}
# placeholders to serve a local build over plain HTTP (see .github/workflows).
{
	servers {
		# Log and rate-limit by the visitor's address, not Cloudflare's edge.
		import {$CADDY_CONFIG_DIR:/etc/caddy}/cloudflare-proxies.caddy
		client_ip_headers CF-Connecting-IP
	}
}

(site) {
	import {$CADDY_CONFIG_DIR:/etc/caddy}/origin-tls.caddy
	encode zstd gzip
}

{$SITE_ADDRESS:aronwagner.com} {
	import site
	log {
		output file {$SITE_LOG:/var/log/caddy/aronwagner.com.log}
	}

	# Security headers, caching and redirects generated by the build for this release.
	import {$SITE_ROOT:/srv/aronwagner.com}/current/site.caddy

	# Fingerprinted assets accumulate across releases, so pages that are already
	# open keep loading their assets after a deploy.
	handle /immutable/* {
		root * {$SITE_ROOT:/srv/aronwagner.com}
		file_server
	}
	handle {
		root * {$SITE_ROOT:/srv/aronwagner.com}/current
		file_server {
			hide site.caddy _headers _redirects
		}
	}
}

{$WWW_ADDRESS:www.aronwagner.com} {
	import site
	redir https://aronwagner.com{uri} permanent
}
