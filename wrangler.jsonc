{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aronwagner-site",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:site",
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [{ "pattern": "aronwagner.com/*", "zone_name": "aronwagner.com" }],
}
