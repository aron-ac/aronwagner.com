{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markhammonds-site",
  "account_id": "2f21a320c1fd6d65df1ac89f4f7662fb",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:site",
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [{ "pattern": "markhammonds.com/*", "zone_name": "markhammonds.com" }],
}
